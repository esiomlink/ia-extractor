    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.1.0",
